<UserControl x:Class="FitnessTimer.BluetoothButtonPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F2F5F9" FontFamily="Microsoft YaHei UI">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="蓝牙配置" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="ModeText" TextWrapping="Wrap" Foreground="#52677C" Margin="0,8,0,8"/>
   <WrapPanel x:Name="Toolbar"><Button Content="扫描蓝牙" Click="Scan_Click" Background="#087F72" Foreground="White" Padding="22,10"/><Button Content="停止扫描" Click="StopScan_Click"/><CheckBox Content="显示全部设备" IsChecked="{Binding ShowAllDevices}" VerticalAlignment="Center" Margin="15,0,0,0"/><TextBlock Text="{Binding VisibleDevices.Count, StringFormat=可选设备：{0} 个}" Foreground="#718096" VerticalAlignment="Center" Margin="15,0,0,0"/></WrapPanel>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SettingsPanel" ItemsSource="{Binding Bindings}"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Padding="12" Background="White" CornerRadius="9" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="Bold"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.VisibleDevices, RelativeSource={RelativeSource AncestorType=UserControl}}" IsSynchronizedWithCurrentItem="False" SelectedItem="{Binding Device}" DisplayMemberPath="Label" IsEnabled="{Binding CanEdit}" Padding="8,7" VerticalContentAlignment="Center"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"><Button Content="连接" Click="Connect_Click" Background="#203852" Foreground="White" Padding="18,8"/><Button Content="断开" Click="Disconnect_Click" Padding="14,8"/></StackPanel>
    <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="准备试按" Click="PrepareTest_Click" Padding="10,5" FontSize="12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NeedsPrepare}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="重新识别按键" Click="Learn_Click" Padding="10,5" FontSize="12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanLearn}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="确认刚才按下了按钮" Click="ConfirmLearn_Click" Padding="10,5" FontSize="12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCandidate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
     <StackPanel><TextBlock Text="{Binding Status}" Foreground="#087F72" TextWrapping="Wrap"/><TextBlock Text="{Binding ProtocolLabel}" Foreground="#718096" FontSize="11" Margin="0,3,0,0"/></StackPanel>
    </DockPanel>
    <Expander Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Header="高级设置（通常无需修改）" Foreground="#718096" Margin="0,5,0,0" FontSize="12"><StackPanel Margin="0,8,0,0">
     <StackPanel IsEnabled="{Binding CanEdit}"><CheckBox Content="自动识别连接通道（推荐）" IsChecked="{Binding Automatic}" Margin="0,0,0,10"/>
      <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding Automatic}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,7,0"><TextBlock Text="服务 UUID"/><TextBox Text="{Binding ServiceUuid, UpdateSourceTrigger=PropertyChanged}" FontSize="12" MaxLength="80"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="通知特征 UUID"/><TextBox Text="{Binding CharacteristicUuid, UpdateSourceTrigger=PropertyChanged}" FontSize="12" MaxLength="80"/></StackPanel>
      </Grid>
      <Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock Text="按下数据（十六进制）"/><TextBox Text="{Binding PressHex, UpdateSourceTrigger=PropertyChanged}" FontSize="12" MaxLength="768"/></StackPanel><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="松开数据（可留空）"/><TextBox Text="{Binding ReleaseHex, UpdateSourceTrigger=PropertyChanged}" FontSize="12" MaxLength="768"/></StackPanel></Grid>
      <CheckBox Content="前缀匹配（按厂商协议设置）" IsChecked="{Binding MatchPrefix}"/>
     </StackPanel>
     <TextBlock Text="{Binding LastPacket}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Presses, StringFormat=已验证按下事件：{0} 次}" Margin="0,5,0,0"/>
    </StackPanel></Expander>
   </Grid></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <Expander Grid.Row="2" Header="连接记录与保存" FontSize="12" Margin="0,8,0,0"><StackPanel><Button Content="保存配置" Click="Save_Click" HorizontalAlignment="Left"/><ListBox ItemsSource="{Binding Log}" Height="130" FontSize="12" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,3"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="支持 BLE 按钮；普通自拍遥控器或键盘式按钮可能需要单独适配。已连接后仍需试按验证，才能用于计时。" TextWrapping="Wrap" Foreground="#718096" Margin="0,7,0,0"/></StackPanel></Expander>
 </Grid>
</UserControl>
