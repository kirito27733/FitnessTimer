<Window x:Class="FitnessTimer.BluetoothButtonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="体能计时 · 蓝牙配置" Width="1040" Height="820" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F2F5F9" FontFamily="Microsoft YaHei UI">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><TextBlock Text="蓝牙配置" FontSize="25" FontWeight="Bold"/>
   <TextBlock Text="每条赛道绑定一个独立 BLE 按钮。先连接并检查按下数据，再回主界面启用“蓝牙终点”。" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <TextBlock x:Name="ModeText" Foreground="#A65D14" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel x:Name="Toolbar" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="扫描附近 BLE 设备（15秒）" Click="Scan_Click" Background="#087F72" Foreground="White"/><Button Content="停止扫描" Click="StopScan_Click"/><Button Content="保存绑定配置" Click="Save_Click"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SettingsPanel" ItemsSource="{Binding Lanes}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Padding="14" Background="White" CornerRadius="10" Margin="0,0,0,12"><StackPanel>
     <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="连接" Click="Connect_Click"/><Button Content="断开" Click="Disconnect_Click"/></StackPanel><TextBlock FontSize="18" FontWeight="Bold"><Run Text="{Binding Lane, Mode=OneWay}"/><Run Text=" 道"/></TextBlock><TextBlock Text="{Binding Status}" Foreground="#087F72" Margin="20,0,0,0"/></DockPanel>
     <Grid IsEnabled="{Binding CanEdit}" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.ColumnSpan="2"><TextBlock Text="按钮设备（按名称和蓝牙地址区分）" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Device}" DisplayMemberPath="Label" Padding="8,6"/></StackPanel>
      <StackPanel Grid.Row="1" Margin="0,9,8,0"><TextBlock Text="服务 UUID（厂商提供）" Margin="0,0,0,4"/><TextBox Text="{Binding ServiceUuid, UpdateSourceTrigger=PropertyChanged}" FontSize="13" MaxLength="80"/></StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,9,0,0"><TextBlock Text="通知特征 UUID（Notify / Indicate）" Margin="0,0,0,4"/><TextBox Text="{Binding CharacteristicUuid, UpdateSourceTrigger=PropertyChanged}" FontSize="13" MaxLength="80"/></StackPanel>
      <StackPanel Grid.Row="2" Margin="0,9,8,0"><TextBlock Text="按下数据（十六进制，默认 01 需按协议修改）" Margin="0,0,0,4"/><TextBox Text="{Binding PressHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="768"/></StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,9,0,0"><TextBlock Text="松开数据（可留空；填入后防止长按重复）" Margin="0,0,0,4"/><TextBox Text="{Binding ReleaseHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="768"/></StackPanel>
      <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="前缀匹配（未勾选为整包精确匹配；需按厂商协议配置）" IsChecked="{Binding MatchPrefix}" Margin="0,10,0,0"/>
     </Grid>
     <DockPanel Margin="0,12,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Presses, StringFormat=已匹配按下事件：{0} 次}" Foreground="#52677C"/><TextBlock Text="{Binding LastPacket}" Foreground="#52677C" TextTrimming="CharacterEllipsis"/></DockPanel>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="接收与连接记录（最新在上，调试按键时主界面不要启用蓝牙终点）" Margin="0,0,0,6"/>
   <ListBox Grid.Row="1" ItemsSource="{Binding Log}" FontFamily="Microsoft YaHei UI" FontSize="12" BorderBrush="#D9E1EA" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,3"/></DataTemplate></ListBox.ItemTemplate></ListBox>
  </Grid>
 </Grid>
</Window>
