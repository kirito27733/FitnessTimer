<UserControl x:Class="FitnessTimer.PreparationPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FitnessTimer" FontFamily="Microsoft YaHei UI">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18">
  <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="保存赛前配置" Click="Save_Click"/><StackPanel><TextBlock Text="赛前准备" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="SaveStatusText" Text="声音和批次名单自动保存。" Foreground="#718096" Margin="0,6,0,0"/></StackPanel></DockPanel>
  <Border Background="#F5F8FB" CornerRadius="10" Padding="16" Margin="0,0,0,16"><StackPanel x:Name="EventInfoPanel">
   <TextBlock Text="活动信息" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="活动名称（顶部大标题）" Margin="0,0,0,6"/><TextBox x:Name="ActivityNameBox" Text="{Binding Settings.ActivityName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="主办单位（标题下方）" Margin="0,0,0,6"/><TextBox x:Name="OrganizerBox" Text="{Binding Settings.Organizer, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/></StackPanel>
   </Grid>
   <TextBlock Text="修改后同步到主界面和外屏，配置自动保存。" Foreground="#718096" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <StackPanel x:Name="SoundsPanel" Orientation="Horizontal" Margin="0,0,0,16">
   <Button x:Name="SoundConfigurationButton" Content="声音文件配置" Click="SoundConfiguration_Click" Background="#203852" Foreground="White"/>
   <TextBlock Text="配置开始、完成、罚时、暂停和继续声音" Foreground="#718096" Margin="12,0,0,0"/>
  </StackPanel>
  <StackPanel x:Name="RosterPanel">
   <DockPanel><TextBlock Text="人员批次卡片" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><WrapPanel HorizontalAlignment="Right"><CheckBox x:Name="SelectAllBatches" Content="全选" Click="SelectAllBatches_Click" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="BatchSelectionText" VerticalAlignment="Center" Foreground="#718096" Margin="0,0,12,0"/><Button x:Name="DeleteSelectedBatches" Content="删除选中" Click="DeleteSelectedBatches_Click" IsEnabled="False" Background="#B42318" Foreground="White"/><Button Content="增加批次" Click="AddBatch_Click" Background="#087F72" Foreground="White"/><Button Content="Excel 导入" Click="Import_Click"/><Button Content="Excel 导出" Click="Export_Click"/><Button Content="导出空白模板" Click="Template_Click"/></WrapPanel></DockPanel>
   <TextBlock Text="每张卡片对应一组，现场点击“下一组”按当前卡片顺序载入。绿色边框表示当前组，可用上移、下移调整顺序。" Foreground="#718096" TextWrapping="Wrap" Margin="0,6,0,12"/>
   <TextBlock x:Name="EmptyText" Text="还没有批次。点击“增加批次”填写姓名，或用 Excel 模板批量导入。" Foreground="#718096" Margin="0,8,0,14"/>
   <ItemsControl x:Name="CardList" ItemsSource="{Binding Settings.Batches}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Border Width="350" CornerRadius="10" Padding="14" BorderThickness="2" Margin="0,0,12,12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F7F9FC"/><Setter Property="BorderBrush" Value="#E1E7EF"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="BorderBrush" Value="#087F72"/><Setter Property="Background" Value="#EDF8F4"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><DockPanel Margin="0,0,0,10"><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="选择此批次" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding Order, StringFormat=第 {0} 组}" FontWeight="Bold" FontSize="17"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="上移" Click="MoveUp_Click" Padding="8,5" FontSize="12"/><Button Content="下移" Click="MoveDown_Click" Padding="8,5" FontSize="12"/><Button Content="删除" Click="RemoveBatch_Click" Padding="8,5" FontSize="12"/></StackPanel></DockPanel>
      <TextBlock Text="批次名称" Margin="0,0,0,4"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
      <Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <StackPanel Margin="0,0,6,8"><TextBlock Text="1 道选手" Margin="0,0,0,4"/><TextBox Text="{Binding Lane1, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="6,0,0,8"><TextBlock Text="2 道选手" Margin="0,0,0,4"/><TextBox Text="{Binding Lane2, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,0,6,0"><TextBlock Text="3 道选手" Margin="0,0,0,4"/><TextBox Text="{Binding Lane3, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="4 道选手" Margin="0,0,0,4"/><TextBox Text="{Binding Lane4, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"/></StackPanel>
      </Grid>
      <Button Content="载入此组" Click="LoadBatch_Click" Background="#203852" Foreground="White"/>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <Expander Header="蓝牙配置" FontSize="17" Margin="0,12,0,8" IsExpanded="False"><local:BluetoothButtonPanel x:Name="BluetoothPanel" Height="720" Margin="0,10,0,0"/></Expander>
 </StackPanel></ScrollViewer>
</UserControl>
