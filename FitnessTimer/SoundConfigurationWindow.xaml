<Window x:Class="FitnessTimer.SoundConfigurationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="声音文件配置" Width="1040" Height="510" MinWidth="880" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#F2F5F9" FontFamily="Microsoft YaHei UI">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><DockPanel><CheckBox x:Name="SoundEnabledBox" DockPanel.Dock="Right" Content="启用事件声音" IsChecked="{Binding SoundEnabled}" VerticalAlignment="Center"/><TextBlock Text="声音文件配置" FontSize="24" FontWeight="Bold"/></DockPanel>
   <TextBlock Text="选择本地 WAV、MP3 等文件；留空使用系统提示音。加罚时播放罚时声音，减罚时不播放。" Foreground="#718096" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SoundList" ItemsSource="{Binding Sounds}"><ItemsControl.ItemTemplate><DataTemplate>
   <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Label}"/><CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
    <TextBox Grid.Column="2" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" FontSize="12" ToolTip="{Binding FilePath}"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="选择文件" Click="BrowseSound_Click" Padding="10,7"/><Button Content="试听" Click="PreviewSound_Click" Padding="10,7"/><Button Content="清除" Click="ClearSound_Click" Padding="10,7"/></StackPanel>
   </Grid>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StopPreviewButton" Content="停止试听" Click="StopSound_Click"/><Button x:Name="DoneButton" Content="完成" Click="Done_Click" Background="#087F72" Foreground="White" Padding="24,9"/></StackPanel><TextBlock Text="修改自动保存，关闭窗口时停止试听。" Foreground="#718096"/></DockPanel>
 </Grid>
</Window>
